# ==============================================================================
# Multi-Agent Environmental Analysis System - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and replace placeholder values with your actual configuration.
# DO NOT commit the .env file to version control.

# ------------------------------------------------------------------------------
# Core Application Settings
# ------------------------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO
DEBUG=false

# ------------------------------------------------------------------------------
# Copernicus Data Space Ecosystem (CDSE) Configuration (Phase 1+)
# ------------------------------------------------------------------------------
# STAC Discovery API endpoint (public, unauthenticated for searching metadata)
CDSE_STAC_BASE_URL=https://stac.dataspace.copernicus.eu/v1
CDSE_COLLECTION_SENTINEL2_L2A=sentinel-2-l2a

# Authentication Token endpoint for downloading full imagery assets
CDSE_TOKEN_URL=https://identity.dataspace.copernicus.eu/auth/realms/CDSE/protocol/openid-connect/token

# Option A: Direct OIDC Bearer Token (if generated manually or externally)
CDSE_ACCESS_TOKEN=your_direct_oidc_access_token_here

# Option B: CDSE User Account Credentials (Free registration at dataspace.copernicus.eu)
# Automatically exchanges username/password for a Bearer token:
CDSE_USERNAME=your_cdse_username_here
CDSE_PASSWORD=your_cdse_password_here

# Optional: CDSE S3 Access Keys (generated in CDSE user profile for direct S3 access)
CDSE_S3_ACCESS_KEY=your_s3_access_key_here
CDSE_S3_SECRET_KEY=your_s3_secret_key_here

# ------------------------------------------------------------------------------
# LLM Provider API Keys (Used by Multi-Agent Coordinator & Analysis Agents in Phase 3+)
# ------------------------------------------------------------------------------
OPENAI_API_KEY=your_openai_api_key_here
GOOGLE_API_KEY=your_google_gemini_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

DEFAULT_LLM_PROVIDER=google
DEFAULT_LLM_MODEL=gemini-1.5-pro

# ------------------------------------------------------------------------------
# Project Directory Paths
# ------------------------------------------------------------------------------
RAW_DATA_DIR=./data/raw
PROCESSED_DATA_DIR=./data/processed
SAMPLE_DATA_DIR=./data/sample
RESULTS_DIR=./results
REPORTS_DIR=./reports
