# ==============================================================================
# Multi-Agent Environmental Analysis System - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and replace placeholder values with your actual configuration.
# DO NOT commit the .env file to version control.

# ------------------------------------------------------------------------------
# Core Application Settings
# ------------------------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO
DEBUG=false

# ------------------------------------------------------------------------------
# LLM Provider API Keys (Used by Multi-Agent Coordinator & Analysis Agents)
# ------------------------------------------------------------------------------
OPENAI_API_KEY=your_openai_api_key_here
GOOGLE_API_KEY=your_google_gemini_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Default LLM Model Configurations
DEFAULT_LLM_PROVIDER=google
DEFAULT_LLM_MODEL=gemini-1.5-pro

# ------------------------------------------------------------------------------
# Earth Observation & Satellite Data Source APIs (Provisional for Phase 1+)
# ------------------------------------------------------------------------------
# NASA Earthdata Login credentials (for Landsat, MODIS, VIIRS access)
NASA_EARTHDATA_USERNAME=your_earthdata_username
NASA_EARTHDATA_PASSWORD=your_earthdata_password
NASA_EARTHDATA_TOKEN=your_earthdata_token_here

# Copernicus Data Space Ecosystem / Sentinel Hub (for Sentinel-2, Sentinel-1)
COPERNICUS_CLIENT_ID=your_copernicus_client_id_here
COPERNICUS_CLIENT_SECRET=your_copernicus_client_secret_here

# Planetary Computer / USGS EROS / Open Data Access
PLANETARY_COMPUTER_API_KEY=your_planetary_computer_key_here

# ------------------------------------------------------------------------------
# Project Directory Paths (Relative to project root or absolute paths)
# ------------------------------------------------------------------------------
RAW_DATA_DIR=./data/raw
PROCESSED_DATA_DIR=./data/processed
SAMPLE_DATA_DIR=./data/sample
RESULTS_DIR=./results
REPORTS_DIR=./reports
